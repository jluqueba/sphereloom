# SphereLoom environment example
# Copy this file to your local environment file and fill in local values.
# Leave secrets blank in committed examples.
# This file mirrors the configuration schema in
# docs/features/osc-camera-control/plan.md (section 11); keep them in sync.

# Workspace and logging
# WORKSPACE_DIR is the path jail: every file SphereLoom writes stays inside it.
SPHERELOOM_WORKSPACE_DIR=./sphereloom-workspace
SPHERELOOM_LOG_LEVEL=INFO
SPHERELOOM_LOG_REDACT=true

# MCP transport
# Supported values: stdio, http. Default: stdio (no network listener at all).
# HTTP transport is opt-in, must stay loopback-bound and requires a bearer token.
# Binding to a non-loopback address additionally requires the acknowledgement flag.
SPHERELOOM_TRANSPORT=stdio
SPHERELOOM_HTTP_HOST=127.0.0.1
SPHERELOOM_HTTP_PORT=8765
SPHERELOOM_HTTP_TOKEN=
SPHERELOOM_HTTP_ALLOW_NON_LOOPBACK=false

# Camera backend
# Supported values: osc, fake (usb from Milestone 3).
# Milestone 1 is OSC Wi-Fi only; fake is for tests, demos and development without hardware.
# The camera is an access point at a fixed address; the host must join its Wi-Fi network.
SPHERELOOM_CAMERA_BACKEND=osc
SPHERELOOM_OSC_BASE_URL=http://192.168.42.1
SPHERELOOM_OSC_CONNECT_TIMEOUT_SECONDS=5
SPHERELOOM_OSC_TIMEOUT_SECONDS=15

# Capture
# Deadline for asynchronous capture commands to report completion.
SPHERELOOM_CAPTURE_TIMEOUT_SECONDS=30

# Jobs
# Long operations (downloads, later exports) run as bounded background jobs.
# Jobs do not survive a server restart in Milestone 1.
SPHERELOOM_MAX_CONCURRENT_JOBS=2
SPHERELOOM_MAX_QUEUED_JOBS=32
SPHERELOOM_JOB_RETENTION_COUNT=100
SPHERELOOM_JOB_RETENTION_HOURS=24

# Destructive operations
# Deletion is disabled by default and always requires a two-step confirmation token.
SPHERELOOM_ENABLE_DESTRUCTIVE_TOOLS=false
SPHERELOOM_CONFIRMATION_TTL_SECONDS=120

# Pagination
# Upper bound on entries returned in a single tool response.
SPHERELOOM_MAX_PAGE_SIZE=100

# Vendor SDK locations
# Users obtain SDKs themselves and point SphereLoom to local copies.
# SphereLoom never redistributes Insta360 SDK binaries.
# Unset is a supported state: affected capabilities report a structured unsupported error.
SPHERELOOM_CAMERA_SDK_PATH=
SPHERELOOM_MEDIA_SDK_PATH=

# Hardware tests
# Leave blank or set to 0 to keep real-camera tests disabled. Never enabled in CI.
SPHERELOOM_ENABLE_HARDWARE_TESTS=0

# Example agent (Milestone 2)
# scripted mode needs no API key, so examples can run in CI against the fake backend.
# Supported modes: scripted, llm.
SPHERELOOM_AGENT_MODE=scripted
SPHERELOOM_AGENT_PROVIDER=
SPHERELOOM_AGENT_MODEL=
SPHERELOOM_AGENT_API_KEY=
SPHERELOOM_AGENT_ENDPOINT=
