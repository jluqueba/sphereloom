# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.Python

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Secrets and local configuration. Only .env.example is committed.
.env
.env.*
!.env.example

# SphereLoom runtime output. Personal photos and video never belong in the repository.
sphereloom-workspace/
*.insv
*.insp
*.mp4
*.jpg
*.jpeg
*.dng

# Vendor SDKs are obtained by each user and are never redistributed. See ADR-0006.
vendor/
sdk/

# uv.lock is deliberately not committed. SphereLoom is a distributable package, not a
# deployed application: runtime dependencies are range-pinned and development tools are
# pinned exactly in pyproject.toml, which is where reproducibility belongs for a library.
# Ignoring the lock also prevents a lockfile generated behind a private package mirror from
# leaking internal index URLs into a public repository.
uv.lock

# Raw, un-redacted camera captures. Only redacted fixtures under tests/fixtures/ are
# committed; see docs/internal/process/recording-camera-fixtures.md.
*.raw.json
captures/
